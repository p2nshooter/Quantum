# Salin ke .env.local untuk pengembangan lokal.
# Di produksi nilai-nilai ini diisi sebagai secret Cloudflare Worker / GitHub Actions —
# jangan pernah commit nilai aslinya.

# URL publik aplikasi (dipakai untuk link di email/notifikasi)
APP_URL=http://localhost:3000

# Akun admin pertama yang dibuat otomatis saat deploy (opsional tapi disarankan).
# Password di-hash PBKDF2 sebelum masuk database, tidak pernah disimpan plaintext.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Opsional: webhook untuk notifikasi permintaan penawaran masuk
# (mis. endpoint bot WhatsApp/Telegram milik sendiri).
NOTIFY_WEBHOOK_URL=
